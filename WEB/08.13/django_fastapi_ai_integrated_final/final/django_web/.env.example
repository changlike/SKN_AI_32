# Django 세션/보안용 키입니다. 실제 운영 환경에서는 반드시 긴 랜덤 문자열로 변경합니다.
DJANGO_SECRET_KEY=change-this-django-secret-key
# 개발 중에는 True, 운영 배포 시 False를 사용합니다.
DJANGO_DEBUG=True
# Django 개발 서버에서 허용할 Host 목록입니다.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Django와 FastAPI가 공통으로 사용하는 MySQL 정보입니다.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=django_member_board
DB_USER=django_user
DB_PASSWORD=django1234!

# Django가 AI 요청을 전달할 FastAPI 서버 주소입니다.
FASTAPI_BASE_URL=http://127.0.0.1:8001
# health/RAG 일반 요청의 최대 대기 시간입니다.
FASTAPI_REQUEST_TIMEOUT=120
# Stable Diffusion/Whisper 등 긴 AI 추론 요청의 최대 대기 시간입니다.
FASTAPI_AI_TIMEOUT=600
