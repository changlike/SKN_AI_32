# Django 개발 모드 여부입니다. 운영 환경에서는 False로 변경합니다.
DJANGO_DEBUG=True
# Django 암호화/서명에 사용하는 비밀키입니다. 실제 환경에서는 충분히 긴 임의 문자열로 변경합니다.
DJANGO_SECRET_KEY=change-this-secret-key
# 접속을 허용할 호스트 목록입니다. 쉼표로 구분합니다.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# MySQL 데이터베이스 이름입니다.
DB_NAME=django_member_board
# MySQL 사용자 이름입니다.
DB_USER=django_user
# MySQL 사용자 비밀번호입니다.
DB_PASSWORD=django1234!
# MySQL 서버 주소입니다.
DB_HOST=127.0.0.1
# MySQL 기본 포트입니다.
DB_PORT=3306

# OpenAI API Key입니다. 실제 Key를 입력하고 이 파일이 아닌 .env로 사용합니다.
OPENAI_API_KEY=sk-your-openai-api-key
# 검색 근거를 사용해 최종 한국어 답변을 생성할 모델입니다.
OPENAI_CHAT_MODEL=gpt-5.6-luna
# 문서/게시글/질문을 벡터로 변환할 임베딩 모델입니다.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
