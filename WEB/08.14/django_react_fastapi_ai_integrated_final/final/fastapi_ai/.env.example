# FastAPI 서비스 이름입니다.
APP_NAME=Django Connected FastAPI AI Service
# 개발 환경의 상세 오류 출력 여부입니다.
DEBUG=True

# Django 브라우저가 FastAPI를 직접 호출하는 경우 허용할 출처입니다.
# 기본 UI는 Django 프록시를 사용하므로 CORS 영향이 작지만 직접 API 호출 테스트도 가능하도록 설정합니다.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# OpenAI RAG 설정입니다.
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Django와 동일한 MySQL을 읽기 위한 접속 정보입니다.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=django_member_board
DB_USER=django_user
DB_PASSWORD=django1234!
DB_ECHO=False

# 멀티모달 AI 모델 설정입니다.
CAPTION_MODEL_ID=Salesforce/blip-image-captioning-base
TRANSLATION_MODEL_ID=facebook/nllb-200-distilled-600M
DIFFUSION_MODEL_ID=stabilityai/stable-diffusion-xl-base-1.0
WHISPER_MODEL_ID=openai/whisper-small
MAX_UPLOAD_SIZE_MB=15
DEFAULT_INFERENCE_STEPS=40
DEFAULT_GUIDANCE_SCALE=8.0
DIFFUSION_IMAGE_SIZE=1024

# RAG 청크 분할 설정입니다.
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
