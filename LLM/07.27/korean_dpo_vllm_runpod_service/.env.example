# FastAPI 서비스 이름입니다.
APP_NAME=한국어 DPO LLM 서비스

# FastAPI가 접속할 vLLM OpenAI 호환 API 주소입니다.
VLLM_BASE_URL=http://127.0.0.1:8001/v1

# vLLM 실행 시 지정한 API 키입니다.
VLLM_API_KEY=local-vllm-key

# 클라이언트 요청에서 기본으로 사용할 모델 이름입니다.
VLLM_MODEL_NAME=korean-dpo-model

# FastAPI 서버 주소입니다.
FASTAPI_HOST=0.0.0.0

# FastAPI 서버 포트입니다.
FASTAPI_PORT=8000

# vLLM 서버 포트입니다.
VLLM_PORT=8001

# 학습 기준 모델입니다.
BASE_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct

# DPO Adapter 저장 경로입니다.
DPO_ADAPTER_PATH=/workspace/korean_dpo_vllm_runpod_service/models/dpo_adapter

# 병합 모델 저장 경로입니다.
MERGED_MODEL_PATH=/workspace/korean_dpo_vllm_runpod_service/models/merged_model

# Hugging Face 비공개 모델을 사용할 때만 입력합니다.
HF_TOKEN=

# 평가 데이터 경로입니다.
EVALUATION_FILE=data/evaluation.jsonl

# 평가 결과 저장 디렉터리입니다.
OUTPUT_DIR=outputs
