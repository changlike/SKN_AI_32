APP_NAME="한국어 음성 RAG 고객 상담 서비스"
HOST=127.0.0.1
PORT=8000
DOCUMENT_DIR=data/docs
RAG_MODE=hybrid
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
RAG_TOP_K=4
CHUNK_SIZE=700
CHUNK_OVERLAP=100
USE_LOCAL_MODEL=false
LOCAL_MODEL_PATH=models/finetuned_model
BASE_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct
LLM_DEVICE=auto
MAX_NEW_TOKENS=384
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
TTS_PROVIDER=edge
EDGE_TTS_VOICE=ko-KR-SunHiNeural
EDGE_TTS_RATE=+0%
