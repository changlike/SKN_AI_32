# 프롬프트 충실도가 높은 기본 SDXL 모델을 지정합니다.
IMAGE_MODEL_ID=stabilityai/stable-diffusion-xl-base-1.0

# VRAM이 부족하면 아래 경량 모델로 바꿀 수 있습니다.
# IMAGE_MODEL_ID=stable-diffusion-v1-5/stable-diffusion-v1-5

# 한국어를 영어로 번역할 MarianMT 모델을 지정합니다.
TRANSLATION_MODEL_ID=Helsinki-NLP/opus-mt-ko-en

# 한국어 프롬프트 자동 번역을 활성화합니다.
ENABLE_PROMPT_TRANSLATION=true

# 핵심 피사체 강조 프롬프트 자동 보강을 활성화합니다.
ENABLE_PROMPT_ENHANCEMENT=true

# 사람이 요청되지 않은 장면에서 인물 생성을 억제합니다.
PREVENT_UNREQUESTED_PEOPLE=true

# SDXL 기본 생성 설정을 지정합니다.
IMAGE_INFERENCE_STEPS=30
IMAGE_GUIDANCE_SCALE=7.0
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024
IMAGE_SAVE_INTERVAL=5

# SDXL은 VRAM 사용량이 크므로 기본적으로 CPU 오프로딩을 활성화합니다.
ENABLE_CPU_OFFLOAD=true
ENABLE_VAE_SLICING=true
ENABLE_VAE_TILING=true
ENABLE_ATTENTION_SLICING=true

# faster-whisper STT 설정을 지정합니다.
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE_CPU=int8
WHISPER_COMPUTE_TYPE_CUDA=float16

# 한국어 음성 인식을 우선 적용합니다.
WHISPER_LANGUAGE=ko
MINIMUM_RECORDING_MS=1200
