# 학습 시작 모델입니다.
BASE_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# SFT LoRA 어댑터 저장 경로입니다.
SFT_ADAPTER=outputs/sft_adapter
# DPO LoRA 어댑터 저장 경로입니다.
DPO_ADAPTER=outputs/dpo_adapter
# 병합된 최종 모델 저장 경로입니다.
MERGED_MODEL=outputs/dpo_merged
# RAG 인덱스 저장 경로입니다.
RAG_INDEX=outputs/rag_index
# transformers 또는 vllm을 선택합니다.
LLM_BACKEND=transformers
# vLLM OpenAI 호환 API 주소입니다.
VLLM_BASE_URL=http://127.0.0.1:8001/v1
# 로컬 vLLM API 키입니다.
VLLM_API_KEY=local-token
# vLLM 서비스 모델명입니다.
VLLM_MODEL_NAME=dpo-korean-model
# 다국어 임베딩 모델입니다.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# 검색 문서 개수입니다.
RAG_TOP_K=3
# Hugging Face 토큰입니다.
HF_TOKEN=
