# 사용할 Faster-Whisper 모델 크기를 지정합니다.
# tiny, base, small, medium, large-v3 등을 사용할 수 있습니다.
WHISPER_MODEL_SIZE=small

# CPU 환경은 cpu, NVIDIA GPU 환경은 cuda를 지정합니다.
WHISPER_DEVICE=cpu

# CPU는 int8, NVIDIA GPU는 float16을 주로 사용합니다.
WHISPER_COMPUTE_TYPE=int8

# 한국어는 ko, 영어는 en을 사용합니다.
# 빈 값으로 설정하면 언어를 자동으로 감지합니다.
WHISPER_LANGUAGE=ko
