# PyCharm 프로젝트 설정 폴더를 버전 관리에서 제외합니다.
.idea/

# Python 가상환경 폴더를 버전 관리에서 제외합니다.
.venv/

# Python 바이트코드 캐시 폴더를 제외합니다.
__pycache__/

# 컴파일된 Python 파일을 제외합니다.
*.pyc

# 실제 녹음 WAV 파일을 버전 관리에서 제외합니다.
recordings/*.wav

# 음성 인식 TXT 결과를 버전 관리에서 제외합니다.
results/*.txt

# 음성 인식 JSON 결과를 버전 관리에서 제외합니다.
results/*.json

# 운영체제가 만드는 임시 파일을 제외합니다.
.DS_Store
Thumbs.db
